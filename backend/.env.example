# Copy this file to backend/.env and fill in values. Never commit .env.
# Optional. Default is backend/dues.db
# DATABASE_URL=sqlite:///path/to/dues.db
# Reply reading (the experiment). Leave empty to use the built-in rule-based reader.
GEMINI_API_KEY=
# Optional: which Gemini model to use.
# GEMINI_MODEL=gemini-2.5-flash
# Where the React app runs; used to build simulated payment links.
# PUBLIC_BASE_URL=http://localhost:5173
